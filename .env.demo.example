# Free-tier public demo: copy this file to .env and add two server-side keys.
# Never expose either key to the browser.
PORT=3000

# ADMIN_PASSWORD protects /admin while visitor analysis stays public. Set
# ANALYSIS_REQUIRE_ADMIN=true only for an intentionally private deployment.
# Keep all values server-side.
ADMIN_PASSWORD=
ANALYSIS_REQUIRE_ADMIN=false
KOMA_CONFIG_SECRET=

# Groq Whisper: OpenAI-compatible ASR with segment timestamps.
ASR_PROVIDER=groq
GROQ_API_KEY=
ASR_MODEL=whisper-large-v3-turbo
ASR_SEGMENT_SECONDS=60
ASR_MAX_SEGMENT_BYTES=8388608
ASR_DIARIZATION=off

# OpenRouter's free router chooses a currently available image-capable model.
VISION_PROVIDER=openrouter
OPENROUTER_API_KEY=
VISION_MODEL=openrouter/free
VISION_MAX_FRAMES=6
VISION_MAX_TOKENS=1600
ARTIFACT_MAX_TOKENS=3000

# Keep a free public demo deliberately small.
MAX_UPLOAD_BYTES=104857600
MAX_DURATION_SECONDS=180
MAX_CONCURRENT_JOBS=1
DEMO_REQUESTS_PER_IP_PER_DAY=3

# Permanent replay uses local storage by default. Production should switch to
# OSS and keep all credentials in deployment secrets.
DB_DRIVER=sqlite
KOMA_DATABASE_PATH=./data/koma.sqlite
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./data/storage

# Enable only when nginx/proxy overwrites X-Forwarded-For from untrusted clients.
TRUST_PROXY=false
